# Secret-free RC10 public Demo runtime admission on the Hong Kong host.
# The selected loopback ports are deliberately not referenced by Nginx. This
# configuration authorizes closed-ingress acceptance only, not public traffic.
COMPANY_OS_DEMO_COMPOSE_PROJECT=company-os-public-demo-rc10
COMPANY_OS_RELEASE_ID=0.1.0-rc.10-5d755eea93d8
COMPANY_OS_API_IMAGE=ghcr.io/elliottyip/company-os-api@sha256:90efc65016b004552273f8a7a9048044876af4e7c380ade5ce45dcf946457331
COMPANY_OS_WEB_IMAGE=ghcr.io/elliottyip/company-os-web@sha256:577a0eee6c5cb44c82159251abf9937d7e287e6221ca3f010a1865369b3c6055
COMPANY_OS_DEMO_API_URL=http://localhost:4671
COMPANY_OS_DEMO_WEB_URL=http://localhost:4670
COMPANY_OS_DEMO_API_LOOPBACK_PORT=4671
COMPANY_OS_DEMO_WEB_LOOPBACK_PORT=4670
COMPANY_OS_DEMO_MAX_SESSIONS=500
COMPANY_OS_DEMO_CREATIONS_PER_MINUTE=120
COMPANY_OS_DEMO_REQUESTS_PER_SESSION_PER_MINUTE=240
