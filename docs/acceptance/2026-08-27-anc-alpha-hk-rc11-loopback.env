# Secret-free RC11 public Demo runtime admission on the Hong Kong host.
# The selected loopback ports are deliberately not referenced by Nginx. This
# configuration authorizes closed-ingress acceptance only, not public traffic.
COMPANY_OS_DEMO_COMPOSE_PROJECT=company-os-public-demo-rc11
COMPANY_OS_RELEASE_ID=0.1.0-rc.11-a2f77df71bf2
COMPANY_OS_API_IMAGE=ghcr.io/elliottyip/company-os-api@sha256:36c63e4ea5d7c3d7c9ccb5e07845420e2d59b9dc14ce6659bc3f0f2f0de9d1a4
COMPANY_OS_WEB_IMAGE=ghcr.io/elliottyip/company-os-web@sha256:55337aa174513e561b2abd789fa8d4b3befff616971a3a9f387383f4f40e6da4
COMPANY_OS_DEMO_API_URL=http://localhost:4681
COMPANY_OS_DEMO_WEB_URL=http://localhost:4680
COMPANY_OS_DEMO_API_LOOPBACK_PORT=4681
COMPANY_OS_DEMO_WEB_LOOPBACK_PORT=4680
COMPANY_OS_DEMO_MAX_SESSIONS=500
COMPANY_OS_DEMO_CREATIONS_PER_MINUTE=120
COMPANY_OS_DEMO_REQUESTS_PER_SESSION_PER_MINUTE=240
