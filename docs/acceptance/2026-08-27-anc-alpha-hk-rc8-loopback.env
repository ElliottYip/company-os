# Secret-free RC8 public Demo runtime admission on the Hong Kong host.
# The selected loopback ports are deliberately not referenced by Nginx. This
# configuration authorizes container-level acceptance only, not public traffic.
COMPANY_OS_DEMO_COMPOSE_PROJECT=company-os-public-demo-rc8
COMPANY_OS_RELEASE_ID=0.1.0-rc.8-3e9e4d058e54
COMPANY_OS_API_IMAGE=ghcr.io/elliottyip/company-os-api@sha256:d6dc0e58332b3554f1c3c6da8ece9a5834fb877679d32ca1062eba2cd873e414
COMPANY_OS_WEB_IMAGE=ghcr.io/elliottyip/company-os-web@sha256:fe601dd5461be93f8bddfe7221e257db0b37c60b7b50e1a3cc19f7e26c1a0786
COMPANY_OS_DEMO_API_URL=http://localhost:4661
COMPANY_OS_DEMO_WEB_URL=http://localhost:4660
COMPANY_OS_DEMO_API_LOOPBACK_PORT=4661
COMPANY_OS_DEMO_WEB_LOOPBACK_PORT=4660
COMPANY_OS_DEMO_MAX_SESSIONS=500
COMPANY_OS_DEMO_CREATIONS_PER_MINUTE=120
COMPANY_OS_DEMO_REQUESTS_PER_SESSION_PER_MINUTE=240
