# Secret-free RC12 Hong Kong closed-ingress admission configuration.
# The browser origins are reached only through an operator SSH tunnel. Docker
# 29 suppresses the requested loopback publications on this internal network;
# the fixed bridge addresses are the authoritative host-ingress targets.
COMPANY_OS_DEMO_COMPOSE_PROJECT=company-os-public-demo-rc12
COMPANY_OS_RELEASE_ID=0.1.0-rc.12-a1358df74535
COMPANY_OS_API_IMAGE=ghcr.io/elliottyip/company-os-api@sha256:171feaf2421dfed1985e92f43448917071c2931dc58dc24329b01a1d21e8a32f
COMPANY_OS_WEB_IMAGE=ghcr.io/elliottyip/company-os-web@sha256:c79aa4bf211b8a3cbf9bb06a922592af97218f92132f721328eeac78326d2e92
COMPANY_OS_DEMO_API_URL=http://localhost:4701
COMPANY_OS_DEMO_WEB_URL=http://localhost:4700
COMPANY_OS_DEMO_API_LOOPBACK_PORT=4701
COMPANY_OS_DEMO_WEB_LOOPBACK_PORT=4700
COMPANY_OS_DEMO_INTERNAL_SUBNET=172.31.11.0/28
COMPANY_OS_DEMO_API_ADDRESS=172.31.11.2
COMPANY_OS_DEMO_WEB_ADDRESS=172.31.11.3
COMPANY_OS_DEMO_MAX_SESSIONS=500
