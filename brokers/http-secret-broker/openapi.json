{
  "openapi": "3.1.0",
  "info": {
    "title": "Company OS HTTP Secret Broker",
    "version": "1.0.0",
    "description": "Customer-owned Secret Broker protocol. Company OS receives reference metadata, opaque leases, and browser handoffs; credential material is never a valid response field."
  },
  "servers": [
    {
      "url": "https://customer-node.invalid",
      "description": "Replace with the customer-owned HTTPS node origin."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Read Secret Broker health",
        "operationId": "secretBrokerHealth",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          }
        ],
        "responses": {
          "200": {
            "description": "Broker health.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{companyId}/references/{referenceId}": {
      "get": {
        "summary": "Read secret-free reference metadata",
        "operationId": "describeSecretReference",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          },
          {
            "name": "companyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          {
            "name": "referenceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reference metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecretReferenceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Reference not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/leases": {
      "post": {
        "summary": "Issue one short-lived opaque lease",
        "operationId": "issueSecretLease",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing idempotent lease.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaseResponse"
                }
              }
            }
          },
          "201": {
            "description": "Lease issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaseResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{companyId}/leases/{leaseId}/revocations": {
      "post": {
        "summary": "Revoke one exact lease idempotently",
        "operationId": "revokeSecretLease",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          },
          {
            "name": "companyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          {
            "name": "leaseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevocationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lease already revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevocationResponse"
                }
              }
            }
          },
          "202": {
            "description": "Revocation accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevocationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reference-management-sessions": {
      "post": {
        "summary": "Begin a broker-owned credential management handoff",
        "operationId": "beginSecretReferenceManagement",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManagementRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing management session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementSessionResponse"
                }
              }
            }
          },
          "201": {
            "description": "Management session created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/companies/{companyId}/reference-management-sessions/{sessionId}": {
      "get": {
        "summary": "Read a secret-free management result",
        "operationId": "getSecretReferenceManagementResult",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          },
          {
            "name": "companyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Management result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementResultResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "ProtocolVersion": {
        "name": "x-company-os-secret-broker-protocol",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "const": "1.0"
        },
        "description": "Company OS execution-plane protocol version."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "HEALTHY",
              "DEGRADED",
              "UNAVAILABLE"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "retryable"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "SecretReference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "companyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "MODEL_PROVIDER",
              "DATA_CONNECTOR",
              "AGENT_CONNECTOR",
              "IDENTITY_ADAPTER"
            ]
          },
          "providerAdapterId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "currentVersion": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "REVOKED"
            ]
          }
        },
        "required": [
          "id",
          "companyId",
          "purpose",
          "providerAdapterId",
          "currentVersion",
          "status"
        ]
      },
      "SecretReferenceResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "$ref": "#/components/schemas/SecretReference"
          }
        },
        "required": [
          "reference"
        ]
      },
      "LeaseIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "companyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "secretReferenceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "consumerId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "workAttemptId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "companyId",
          "secretReferenceId",
          "expectedVersion",
          "consumerId",
          "workAttemptId",
          "reasonCode",
          "expiresAt"
        ]
      },
      "LeaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "intent": {
            "$ref": "#/components/schemas/LeaseIntent"
          },
          "authorizationReceiptId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "schemaVersion",
          "intent",
          "authorizationReceiptId"
        ]
      },
      "SecretLease": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "secretReferenceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "consumerId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "workAttemptId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "attestationDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "secretReferenceId",
          "version",
          "consumerId",
          "workAttemptId",
          "issuedAt",
          "expiresAt",
          "attestationDigest"
        ]
      },
      "LeaseResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lease": {
            "$ref": "#/components/schemas/SecretLease"
          }
        },
        "required": [
          "lease"
        ]
      },
      "RevocationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
          }
        },
        "required": [
          "schemaVersion",
          "reasonCode"
        ]
      },
      "RevocationResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revoked": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "revoked"
        ]
      },
      "ManagementIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "companyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "referenceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "operation": {
            "type": "string",
            "enum": [
              "CREATE",
              "ROTATE",
              "SUSPEND",
              "REVOKE"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "MODEL_PROVIDER",
              "DATA_CONNECTOR",
              "AGENT_CONNECTOR",
              "IDENTITY_ADAPTER"
            ]
          },
          "providerAdapterId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "expectedVersion": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "companyId",
          "referenceId",
          "operation",
          "purpose",
          "providerAdapterId",
          "expectedVersion"
        ]
      },
      "ManagementRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "intent": {
            "$ref": "#/components/schemas/ManagementIntent"
          },
          "authorizationReceiptId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "schemaVersion",
          "intent",
          "authorizationReceiptId"
        ]
      },
      "ManagementSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "companyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "referenceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "operation": {
            "type": "string",
            "enum": [
              "CREATE",
              "ROTATE",
              "SUSPEND",
              "REVOKE"
            ]
          },
          "managementUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "companyId",
          "referenceId",
          "operation",
          "managementUrl",
          "expiresAt"
        ]
      },
      "ManagementSessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session": {
            "$ref": "#/components/schemas/ManagementSession"
          }
        },
        "required": [
          "session"
        ]
      },
      "ManagementPending": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "PENDING"
          }
        },
        "required": [
          "status"
        ]
      },
      "ManagementFailed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "FAILED"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "code",
          "retryable"
        ]
      },
      "ManagementCompleted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "COMPLETED"
          },
          "reference": {
            "$ref": "#/components/schemas/SecretReference"
          }
        },
        "required": [
          "status",
          "reference"
        ]
      },
      "ManagementResultResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ManagementPending"
              },
              {
                "$ref": "#/components/schemas/ManagementFailed"
              },
              {
                "$ref": "#/components/schemas/ManagementCompleted"
              }
            ]
          }
        },
        "required": [
          "result"
        ]
      }
    }
  }
}
