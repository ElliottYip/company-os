{
  "name": "company-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:upstreams": "node scripts/check-upstream-governance.mjs",
    "build": "vite build --config web/vite.config.mjs",
    "verify": "npm test && npm run check:boundaries && npm run check:upstreams && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  }
}
