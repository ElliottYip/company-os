{
  "name": "company-os",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.mjs",
    "start": "node --experimental-strip-types adapters/http/service-entry.ts",
    "start:web": "node scripts/serve-web.mjs",
    "start:managed-cloud": "COMPANY_OS_PROFILE=managed-cloud node --experimental-strip-types adapters/http/service-entry.ts",
    "start:self-hosted": "COMPANY_OS_PROFILE=self-hosted node --experimental-strip-types adapters/http/service-entry.ts",
    "build:federated-source-reference": "node scripts/build-federated-source-reference.mjs --write",
    "db:migrate": "node --experimental-strip-types scripts/migrate-postgres.ts",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:staging-bundle": "node scripts/create-staging-release-bundle.mjs",
    "release:staging-archive": "node scripts/create-portable-staging-archive.mjs",
    "release:staging-install": "node --experimental-strip-types scripts/install-staging-release-bundle.mjs",
    "release:staging-start": "node --experimental-strip-types scripts/start-staging-release.mjs",
    "release:staging-dependencies": "node --experimental-strip-types scripts/run-staging-dependency-phase.mjs",
    "release:staging-migrate": "node --experimental-strip-types scripts/run-staging-migration-phase.mjs",
    "release:staging-product-start": "node --experimental-strip-types scripts/run-staging-product-start-phase.mjs",
    "release:staging-acceptance-handoff": "node --experimental-strip-types scripts/run-staging-acceptance-phase.mjs",
    "release:staging-upgrade-plan": "node --experimental-strip-types scripts/plan-staging-upgrade.ts",
    "release:staging-upgrade-traffic": "node --experimental-strip-types scripts/execute-staging-upgrade-traffic.ts",
    "release:staging-upgrade-acceptance-handoff": "node --experimental-strip-types scripts/run-staging-upgrade-acceptance-handoff.ts",
    "release:staging-acceptance-maintenance": "node --experimental-strip-types scripts/staging-acceptance-maintenance-operation.ts",
    "release:staging-restart": "node --experimental-strip-types scripts/restart-staging-release.mjs",
    "release:cutover-plan": "node scripts/plan-release-cutover.mjs",
    "release:sbom": "npm sbom --omit=dev --omit=optional --sbom-format cyclonedx",
    "ops:restore-drill": "node --experimental-strip-types scripts/postgres-restore-drill.ts",
    "ops:encrypted-backup": "node --experimental-strip-types scripts/postgres-encrypted-backup.ts",
    "ops:retrieve-offsite-backup": "node --experimental-strip-types scripts/retrieve-offsite-encrypted-backup.ts",
    "ops:encrypted-restore-drill": "node --experimental-strip-types scripts/postgres-encrypted-restore-drill.ts",
    "ops:provision-runtime-role": "node --experimental-strip-types scripts/provision-postgres-runtime-role.ts",
    "ops:provision-managed-admin": "node --experimental-strip-types scripts/provision-managed-instance-admin.ts",
    "ops:preflight:customer-boundaries": "node --experimental-strip-types scripts/customer-boundary-preflight.ts",
    "ops:doctor:staging": "node --experimental-strip-types scripts/staging-deployment-doctor.ts",
    "ops:validate:staging-dependencies": "node --experimental-strip-types scripts/validate-staging-dependencies.ts",
    "ops:verify:feishu-directory": "node --experimental-strip-types scripts/verify-feishu-directory.ts",
    "ops:bootstrap:legacy-tenant-route": "node --experimental-strip-types scripts/bootstrap-legacy-tenant-route.ts",
    "ops:generate:tenant-signup-invites": "node --experimental-strip-types scripts/generate-tenant-signup-invites.ts",
    "ops:smoke:multi-tenant-public": "node --experimental-strip-types scripts/smoke-multi-tenant-public.ts",
    "ops:status:staging": "node --experimental-strip-types scripts/inspect-staging-runtime.mjs",
    "ops:drain:staging": "node --experimental-strip-types scripts/inspect-deployment-drain.ts",
    "ops:adoption:staging": "node --experimental-strip-types scripts/verify-deployment-state-adoption.ts",
    "ops:plan:customer-acceptance": "node scripts/prepare-customer-acceptance-plan.mjs",
    "ops:validate:customer-acceptance": "node scripts/validate-customer-acceptance-record.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:oidc:keycloak": "npm run build && node scripts/run-keycloak-oidc-compatibility.mjs",
    "test:restore:postgres16": "node scripts/run-postgres-restore-admission.mjs",
    "test:encrypted-backup:postgres16": "node scripts/run-postgres-encrypted-backup-admission.mjs",
    "test:runtime-role:postgres16": "node scripts/run-postgres-runtime-role-admission.mjs",
    "test:resilience:http": "node --experimental-strip-types scripts/http-resilience-admission.ts",
    "test:soak:http": "node --experimental-strip-types scripts/http-soak-admission.ts",
    "test:customer-boundaries:tls": "node scripts/run-customer-boundary-tls-admission.mjs",
    "test:codex:local": "node scripts/run-local-codex-admission.mjs",
    "test:codex:http-local": "node scripts/run-local-codex-http-admission.mjs",
    "agent:preflight": "node --experimental-strip-types scripts/local-agent-preflight.mjs",
    "test:vault:compatibility": "node scripts/run-vault-compatibility-admission.mjs",
    "test:upgrade:postgres16": "node scripts/run-postgres-upgrade-admission.mjs",
    "test:upgrade:postgres-major": "node scripts/run-postgres-major-version-admission.mjs",
    "test:compose:self-hosted": "node scripts/run-self-hosted-compose-admission.mjs",
    "test:compose:managed-cloud": "COMPANY_OS_COMPOSE_ADMISSION_PROFILE=managed-cloud node scripts/run-self-hosted-compose-admission.mjs",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:independence": "node scripts/check-independent-runtime.mjs",
    "check:research": "node scripts/check-upstream-governance.mjs",
    "check:protocols": "node scripts/generate-execution-plane-openapi.mjs",
    "check:connector-bundles": "node scripts/build-federated-source-reference.mjs",
    "check:web-interactions": "node scripts/check-web-interactions.mjs",
    "check:ai-control-responsive": "node --experimental-strip-types scripts/verify-ai-control-responsive.ts",
    "research:paperclip:inventory": "node research/paperclip/generate-repository-inventory.mjs --write",
    "research:paperclip:inventory:check": "node research/paperclip/generate-repository-inventory.mjs --check",
    "research:paperclip:complete": "node research/paperclip/generate-repository-inventory.mjs --complete",
    "research:competitors:inventory": "node research/competitive-audit/generate-inventories.mjs --write",
    "research:competitors:inventory:check": "node research/competitive-audit/generate-inventories.mjs --check && npm run research:paperclip:inventory:check",
    "research:competitors:complete": "node research/competitive-audit/generate-inventories.mjs --complete",
    "security:secrets": "node scripts/check-company-os-secrets.mjs",
    "security:dependencies": "npm audit --omit=dev --omit=optional --audit-level=moderate",
    "security": "npm run security:secrets && npm run security:dependencies",
    "build": "vite build --config web/vite.config.mjs && node scripts/check-built-web-runtime-config-order.mjs",
    "verify": "npm test && npm run check:boundaries && npm run check:independence && npm run check:research && npm run check:protocols && npm run check:connector-bundles && npm run check:web-interactions && npm run security && npm run typecheck && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/dagre": "^0.7.52",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "esbuild": "0.28.2",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1118.0",
    "@company-os/http-agent-node-connector": "file:connectors/http-agent-node",
    "@company-os/http-data-node-connector": "file:connectors/http-data-node",
    "@company-os/federated-source-reference": "file:connectors/federated-source-reference",
    "@company-os/http-secret-broker": "file:brokers/http-secret-broker",
    "@dagrejs/dagre": "^1.1.5",
    "@xyflow/react": "^12.8.5",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "lucide": "^1.33.0",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
