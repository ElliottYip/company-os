{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-os:agentboss-school:completion-submission:v1",
  "title": "AgentBoss School completion submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "credentialType", "courseVersion", "cohort", "holder", "completion", "assessment"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "credentialType": { "const": "AGENT_BOSS_FOUNDATIONS" },
    "courseVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "cohort": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "holder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicName", "publicHandle", "profileUrl", "yearbookConsent"],
      "properties": {
        "publicName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "publicHandle": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "profileUrl": { "type": ["string", "null"], "pattern": "^https://" },
        "yearbookConsent": { "type": "boolean" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completedNodes", "labNode", "labLevel", "competencies"],
      "properties": {
        "completedNodes": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
        "labNode": { "const": "shared/demo-responsibility-loop" },
        "labLevel": { "enum": ["capable", "strong"] },
        "competencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delegation", "operations", "governance", "teamAdoption"],
          "properties": {
            "delegation": { "enum": ["capable", "strong"] },
            "operations": { "enum": ["capable", "strong"] },
            "governance": { "enum": ["capable", "strong"] },
            "teamAdoption": { "enum": ["unknown", "developing", "capable", "strong"] }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reviewerRole", "reviewedAt", "evidenceSummary", "evidenceReferences"],
      "properties": {
        "method": { "const": "ISSUER_REVIEW" },
        "reviewerRole": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reviewedAt": { "type": "string", "format": "date" },
        "evidenceSummary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceReferences": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 500 }
        }
      }
    }
  }
}
