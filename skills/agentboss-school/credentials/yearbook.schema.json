{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-os:agentboss-school:yearbook:v1",
  "title": "AgentBoss School Yearbook v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "const": "AgentBoss School Yearbook" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credentialId", "publicName", "publicHandle", "profileUrl", "credentialName", "cohort", "courseVersion", "issuedAt", "verificationPath"],
        "properties": {
          "credentialId": { "type": "string" },
          "publicName": { "type": "string" },
          "publicHandle": { "type": ["string", "null"] },
          "profileUrl": { "type": ["string", "null"] },
          "credentialName": { "type": "string" },
          "cohort": { "type": "string" },
          "courseVersion": { "type": "string" },
          "issuedAt": { "type": "string" },
          "verificationPath": { "type": "string" }
        }
      }
    }
  }
}
