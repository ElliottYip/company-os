{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-os:agentboss-school:revocations:v1",
  "title": "AgentBoss School credential revocations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revocations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credentialId", "revokedAt", "reasonCode", "publicNote"],
        "properties": {
          "credentialId": { "type": "string" },
          "revokedAt": { "type": "string", "format": "date-time" },
          "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "publicNote": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
