{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-os:agentboss-school:case-catalog:v1",
  "title": "AgentBoss School case catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "language",
        "status",
        "caseType",
        "industries",
        "capabilities",
        "lessonNodes",
        "evidenceQuality",
        "isAnonymized",
        "source",
        "outcomeClaims",
        "contentFile",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^case-[a-z0-9][a-z0-9-]{0,58}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "language": { "enum": ["zh-CN", "en"] },
        "status": { "enum": ["DRAFT", "VERIFIED", "RETIRED"] },
        "caseType": {
          "enum": ["DEMO_FIXTURE", "SYNTHETIC_SCENARIO", "PROJECT_OWNED", "AUTHORIZED_CLIENT", "PUBLIC_SOURCE"]
        },
        "industries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "enum": ["delegation", "operations", "governance", "team-adoption", "fde"]
          }
        },
        "lessonNodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "evidenceQuality": {
          "enum": ["ILLUSTRATIVE", "SOURCE_BACKED", "CLIENT_VERIFIED"]
        },
        "isAnonymized": { "type": "boolean" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "uri", "consentReference"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "uri": { "type": ["string", "null"], "maxLength": 500 },
            "consentReference": { "type": ["string", "null"], "maxLength": 200 }
          }
        },
        "outcomeClaims": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "evidenceReference", "verification"],
            "properties": {
              "claim": { "type": "string", "minLength": 1, "maxLength": 500 },
              "evidenceReference": { "type": ["string", "null"], "maxLength": 500 },
              "verification": {
                "enum": ["UNVERIFIED", "SOURCE_BACKED", "CLIENT_VERIFIED"]
              }
            }
          }
        },
        "contentFile": {
          "type": "string",
          "pattern": "^references/cases/[a-z0-9][a-z0-9-]*\\.md$"
        },
        "updatedAt": { "type": "string", "format": "date" }
      }
    }
  }
}
