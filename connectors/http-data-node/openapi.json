{
  "openapi": "3.1.0",
  "info": {
    "title": "Company OS HTTP Data Node",
    "version": "1.0.0",
    "description": "Customer-owned data-plane protocol. Granted responses contain references and digests, never enterprise record content."
  },
  "servers": [
    {
      "url": "https://customer-node.invalid",
      "description": "Replace with the customer-owned HTTPS node origin."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Read Data Node health",
        "operationId": "dataNodeHealth",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          }
        ],
        "responses": {
          "200": {
            "description": "Node health.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/data-access": {
      "post": {
        "summary": "Evaluate and execute governed data access",
        "operationId": "accessData",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DataAccessEnvelope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data access granted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataAccessResponse"
                }
              }
            }
          },
          "201": {
            "description": "Data access granted and reference created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataAccessResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Policy denied access without reading the source.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataAccessResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "ProtocolVersion": {
        "name": "x-company-os-data-connector-protocol",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "const": "1.0"
        },
        "description": "Company OS execution-plane protocol version."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "HEALTHY",
              "DEGRADED",
              "UNAVAILABLE"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "retryable"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "DataAccessRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "companyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "workId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "agentId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "dataSourceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "authorizationContractId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "authorizationReceiptId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "operation": {
            "type": "string",
            "enum": [
              "READ",
              "WRITE",
              "EXPORT"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "classification": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED"
            ]
          },
          "destinationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "contentDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "requestId",
          "companyId",
          "workId",
          "agentId",
          "dataSourceId",
          "authorizationContractId",
          "authorizationReceiptId",
          "operation",
          "purpose",
          "classification",
          "destinationId",
          "contentDigest",
          "requestedAt"
        ]
      },
      "DataAccessEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "request": {
            "$ref": "#/components/schemas/DataAccessRequest"
          }
        },
        "required": [
          "schemaVersion",
          "request"
        ]
      },
      "DataGranted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "GRANTED"
          },
          "dataReference": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "evidenceReference": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "type",
          "dataReference",
          "evidenceReference",
          "contentDigest"
        ]
      },
      "DataDenied": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "DENIED"
          },
          "policyCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "policyCode",
          "retryable"
        ]
      },
      "DataAccessResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DataGranted"
              },
              {
                "$ref": "#/components/schemas/DataDenied"
              }
            ]
          }
        },
        "required": [
          "result"
        ]
      }
    }
  }
}
