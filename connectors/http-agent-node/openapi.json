{
  "openapi": "3.1.0",
  "info": {
    "title": "Company OS HTTP Agent Node",
    "version": "1.0.0",
    "description": "Vendor-neutral Agent execution protocol. Payloads are secret-free and contain bounded references, evidence digests, and exact approval actions only."
  },
  "servers": [
    {
      "url": "https://customer-node.invalid",
      "description": "Replace with the customer-owned HTTPS node origin."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Read Agent Node health",
        "operationId": "agentNodeHealth",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          }
        ],
        "responses": {
          "200": {
            "description": "Node health.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/deployments": {
      "post": {
        "summary": "Create or recover an idempotent Agent deployment",
        "operationId": "deployAgent",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing deployment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentResponse"
                }
              }
            }
          },
          "201": {
            "description": "Deployment created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work": {
      "post": {
        "summary": "Submit one idempotent Work request",
        "operationId": "submitWork",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing accepted execution.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkAccepted"
                }
              }
            }
          },
          "202": {
            "description": "Work accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkAccepted"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work/{workId}/observations": {
      "get": {
        "summary": "Read ordered Work observations",
        "operationId": "observeWork",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          },
          {
            "name": "workId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete ordered observation stream.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/work/{workId}/commands": {
      "post": {
        "summary": "Pause, resume, or cancel one exact Work",
        "operationId": "commandWork",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProtocolVersion"
          },
          {
            "name": "workId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent command accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandAccepted"
                }
              }
            }
          },
          "202": {
            "description": "Command accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandAccepted"
                }
              }
            }
          },
          "401": {
            "description": "Bearer authentication failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Bounded request or response limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Node rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Stable node failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "ProtocolVersion": {
        "name": "x-company-os-connector-protocol",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "const": "1.0"
        },
        "description": "Company OS execution-plane protocol version."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "HEALTHY",
              "DEGRADED",
              "UNAVAILABLE"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "retryable"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AgentDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "companyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "runtimeConnectorId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "accountableHumanId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "autonomyLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "required": [
          "id",
          "companyId",
          "displayName",
          "runtimeConnectorId",
          "accountableHumanId",
          "role",
          "autonomyLevel"
        ]
      },
      "DeploymentRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "agent": {
            "$ref": "#/components/schemas/AgentDescriptor"
          }
        },
        "required": [
          "schemaVersion",
          "agent"
        ]
      },
      "DeploymentResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deploymentId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "deploymentId"
        ]
      },
      "ModelExecutionBinding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "policyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "routeId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "providerAdapterId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "modelReference": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "classification": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED"
            ]
          },
          "residency": {
            "type": "string",
            "enum": [
              "MANAGED_CLOUD",
              "LOCAL"
            ]
          },
          "executionGrantReference": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "policyId",
          "routeId",
          "providerAdapterId",
          "modelReference",
          "classification",
          "residency",
          "executionGrantReference"
        ]
      },
      "WorkExecutionInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actionReferences": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "permissionReferences": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "dataAuthorizationReferences": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "governedDataReferences": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "dataEvidenceReferences": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "executionGrantReferences": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "responsibilityContractId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "responsibilityContractRevision": {
            "type": "integer",
            "minimum": 1
          },
          "modelBinding": {
            "$ref": "#/components/schemas/ModelExecutionBinding"
          }
        },
        "required": [
          "actionReferences",
          "permissionReferences",
          "dataAuthorizationReferences",
          "responsibilityContractId",
          "responsibilityContractRevision"
        ]
      },
      "WorkRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "companyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "agentId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "requestedBy": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "input": {
            "$ref": "#/components/schemas/WorkExecutionInput"
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "timeoutAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "companyId",
          "agentId",
          "requestedBy",
          "goal",
          "input",
          "idempotencyKey",
          "timeoutAt"
        ]
      },
      "RuntimeProof": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "proofId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "connectorId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "proofId",
          "connectorId",
          "issuedAt",
          "expiresAt",
          "digest"
        ]
      },
      "WorkSubmission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "deployment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "agentId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              }
            },
            "required": [
              "id",
              "agentId"
            ]
          },
          "request": {
            "$ref": "#/components/schemas/WorkRequest"
          },
          "runtimeProof": {
            "$ref": "#/components/schemas/RuntimeProof"
          }
        },
        "required": [
          "schemaVersion",
          "deployment",
          "request",
          "runtimeProof"
        ]
      },
      "WorkAccepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean",
            "const": true
          },
          "executionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "accepted",
          "executionId"
        ]
      },
      "ExactAction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "inputDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "risk": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "description",
          "inputDigest",
          "risk"
        ]
      },
      "EvidenceOutput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidenceReference": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "evidenceReference",
          "contentDigest"
        ]
      },
      "UsageOutput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "usageReference": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "biller": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "billingType": {
            "type": "string",
            "enum": [
              "metered_api",
              "subscription_included",
              "subscription_overage",
              "credits",
              "fixed",
              "unknown"
            ]
          },
          "costStatus": {
            "type": "string",
            "enum": [
              "reported",
              "unpriced"
            ]
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "cachedInputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "costCents": {
            "type": "integer",
            "minimum": 0
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "usageReference",
          "biller",
          "billingType",
          "costStatus",
          "inputTokens",
          "cachedInputTokens",
          "outputTokens",
          "costCents",
          "occurredAt"
        ]
      },
      "ApprovalRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "action": {
            "$ref": "#/components/schemas/ExactAction"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "requestId",
          "action",
          "expiresAt"
        ]
      },
      "WorkObservation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "WORKING",
              "WAITING",
              "BLOCKED",
              "AWAITING_APPROVAL",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "evidenceOutputs": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/EvidenceOutput"
            }
          },
          "usageOutputs": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/UsageOutput"
            }
          },
          "resultReference": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "approvalRequest": {
            "$ref": "#/components/schemas/ApprovalRequest"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "workId",
          "sequence",
          "status",
          "summary",
          "evidenceRefs",
          "recordedAt"
        ]
      },
      "ObservationResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observations": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/WorkObservation"
            }
          }
        },
        "required": [
          "observations"
        ]
      },
      "PauseCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "operation": {
            "type": "string",
            "const": "PAUSE"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "schemaVersion",
          "operation",
          "reason"
        ]
      },
      "ResumeCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "operation": {
            "type": "string",
            "const": "RESUME"
          },
          "approvalId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "schemaVersion",
          "operation",
          "approvalId"
        ]
      },
      "CancelCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "operation": {
            "type": "string",
            "const": "CANCEL"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "schemaVersion",
          "operation",
          "reason"
        ]
      },
      "CommandRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PauseCommand"
          },
          {
            "$ref": "#/components/schemas/ResumeCommand"
          },
          {
            "$ref": "#/components/schemas/CancelCommand"
          }
        ]
      },
      "CommandAccepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "accepted"
        ]
      }
    }
  }
}
