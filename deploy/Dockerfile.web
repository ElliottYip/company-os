FROM node:22.12.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY brokers ./brokers
COPY connectors ./connectors
RUN npm ci --ignore-scripts
COPY core ./core
COPY ports ./ports
COPY application ./application
COPY adapters ./adapters
COPY connector-sdk ./connector-sdk
COPY web ./web
COPY scripts/check-built-web-runtime-config-order.mjs ./scripts/check-built-web-runtime-config-order.mjs
COPY scripts/write-web-build-manifest.mjs ./scripts/write-web-build-manifest.mjs
ARG COMPANY_OS_SOURCE_REVISION=local
RUN npm run build && node scripts/write-web-build-manifest.mjs "${COMPANY_OS_SOURCE_REVISION}"

FROM node:22.12.0-bookworm-slim
ARG COMPANY_OS_SOURCE_REVISION=local
LABEL org.opencontainers.image.revision="${COMPANY_OS_SOURCE_REVISION}"
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/web/dist ./web/dist
COPY --chown=node:node scripts/serve-web.mjs ./scripts/serve-web.mjs
USER node
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=4 \
  CMD node -e "fetch('http://127.0.0.1:8080/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "scripts/serve-web.mjs"]
