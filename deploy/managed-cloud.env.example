# Public coordinates. Managed-cloud deployments require HTTPS and exact origins.
COMPANY_OS_PUBLIC_URL=https://api.company-os.example.com
COMPANY_OS_WEB_ORIGINS=https://company-os.example.com
COMPANY_OS_IDENTITY_PROVIDER=OIDC
COMPANY_OS_OIDC_ISSUER=https://identity.example.com
COMPANY_OS_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
COMPANY_OS_OIDC_CLIENT_ID=CHANGE_ME_PRODUCT_SCOPED_CLIENT_ID
COMPANY_OS_OIDC_REDIRECT_URI=https://api.company-os.example.com/api/auth/oauth2/callback/enterprise-oidc
# For a Feishu-backed tenant, set COMPANY_OS_IDENTITY_PROVIDER=FEISHU and
# replace the OIDC variables above with these provider coordinates.
# COMPANY_OS_FEISHU_APP_ID=CHANGE_ME_FEISHU_APP_ID
# COMPANY_OS_FEISHU_TENANT_KEY=CHANGE_ME_FEISHU_TENANT_KEY
# COMPANY_OS_FEISHU_REDIRECT_URI=https://api.company-os.example.com/api/auth/oauth2/callback/feishu
COMPANY_OS_INSTANCE_ID=CHANGE_ME_STABLE_INSTANCE_ID
COMPANY_OS_RETENTION_POLICY_ID=standard-retention
COMPANY_OS_ACCOUNTABILITY_EXPORT_POLICY_ID=standard-accountability-export
COMPANY_OS_TRUSTED_PROXY_CIDRS=CHANGE_ME_INGRESS_PROXY_CIDRS

# Immutable release coordinates. Tags and latest are not admitted.
COMPANY_OS_API_IMAGE=registry.example.com/company-os/api@sha256:CHANGE_ME_64_HEX_DIGEST
COMPANY_OS_WEB_IMAGE=registry.example.com/company-os/web@sha256:CHANGE_ME_64_HEX_DIGEST

# Inject these four values from the deployment secret manager. Never commit them.
COMPANY_OS_MIGRATION_DATABASE_URL=CHANGE_ME_MIGRATION_DATABASE_SECRET_REFERENCE
COMPANY_OS_DATABASE_URL=CHANGE_ME_RUNTIME_DATABASE_SECRET_REFERENCE
COMPANY_OS_RUNTIME_DATABASE_USER=company_os_runtime
COMPANY_OS_RUNTIME_DATABASE_PASSWORD=CHANGE_ME_BASE64URL_RUNTIME_DATABASE_PASSWORD
COMPANY_OS_OIDC_CLIENT_SECRET=CHANGE_ME_SECRET_REFERENCE
# COMPANY_OS_FEISHU_APP_SECRET=CHANGE_ME_SECRET_REFERENCE
COMPANY_OS_SESSION_SIGNING_KEY=CHANGE_ME_SECRET_REFERENCE

# Optional multi-company registration. Keep disabled until a canary App ID is
# allowlisted. Open registration is a separate, explicit operator decision.
COMPANY_OS_MULTI_TENANT_SAAS_ENABLED=false
COMPANY_OS_TENANT_PUBLIC_SIGNUP_UNRESTRICTED=false
COMPANY_OS_TENANT_SIGNUP_APP_ALLOWLIST=CHANGE_ME_CANARY_APP_ID
COMPANY_OS_TENANT_SIGNUP_INVITE_HMAC_KEY=INJECT_32_BYTE_BASE64URL_SECRET_FROM_SECRET_MANAGER
COMPANY_OS_TENANT_SIGNUP_INVITE_DIGESTS=CHANGE_ME_HMAC_SHA256_DIGESTS_SEPARATED_BY_COMMAS
COMPANY_OS_TENANT_SIGNUPS_PER_MINUTE=20
COMPANY_OS_TENANT_WEB_BASE_URL=https://company-os.example.com
COMPANY_OS_TENANT_SECRET_KEY_VERSION=key-v1
COMPANY_OS_TENANT_SECRET_MASTER_KEY=CHANGE_ME_32_BYTE_BASE64URL_SECRET_REFERENCE

# Optional installed edge packages. Provider credentials stay in their owners.
COMPANY_OS_CONNECTOR_PACKAGES=
COMPANY_OS_SECRET_BROKER_PACKAGE=
COMPANY_OS_MODEL_PROVIDER_PACKAGES=
COMPANY_OS_DATA_CONNECTOR_PACKAGES=
COMPANY_OS_HTTP_AGENT_NODE_ID=http-agent-node
COMPANY_OS_HTTP_AGENT_NODE_NAME=Enterprise HTTP Agent Node
COMPANY_OS_HTTP_AGENT_NODE_BASE_URL=
COMPANY_OS_HTTP_AGENT_NODE_BEARER_TOKEN=CHANGE_ME_SECRET_REFERENCE
COMPANY_OS_HTTP_AGENT_NODE_TIMEOUT_MS=10000
COMPANY_OS_HTTP_DATA_NODE_ID=http-data-node
COMPANY_OS_HTTP_DATA_NODE_NAME=Enterprise HTTP Data Node
COMPANY_OS_HTTP_DATA_NODE_SOURCES=
COMPANY_OS_HTTP_DATA_NODE_OPERATIONS=READ
COMPANY_OS_HTTP_DATA_NODE_BASE_URL=
COMPANY_OS_HTTP_DATA_NODE_BEARER_TOKEN=CHANGE_ME_SECRET_REFERENCE
COMPANY_OS_HTTP_DATA_NODE_TIMEOUT_MS=10000
COMPANY_OS_HTTP_SECRET_BROKER_ID=http-secret-broker
COMPANY_OS_HTTP_SECRET_BROKER_NAME=Enterprise HTTP Secret Broker
COMPANY_OS_HTTP_SECRET_BROKER_BASE_URL=
COMPANY_OS_HTTP_SECRET_BROKER_BEARER_TOKEN=CHANGE_ME_SECRET_REFERENCE
COMPANY_OS_HTTP_SECRET_BROKER_TIMEOUT_MS=10000
COMPANY_OS_HTTP_SECRET_BROKER_MAXIMUM_LEASE_SECONDS=600
