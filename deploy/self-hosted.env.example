# Formal self-hosted coordinates. Terminate TLS at the enterprise ingress.
COMPANY_OS_PUBLIC_URL=https://company-os-api.example.com
COMPANY_OS_WEB_ORIGINS=https://company-os.example.com
COMPANY_OS_API_PORT=4310
COMPANY_OS_WEB_PORT=8080
COMPANY_OS_EXPOSURE=private

# Database. Replace every CHANGE_ME value before starting.
POSTGRES_DB=company_os
POSTGRES_USER=company_os_owner
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
COMPANY_OS_RUNTIME_DATABASE_USER=company_os_runtime
COMPANY_OS_RUNTIME_DATABASE_PASSWORD=CHANGE_ME_BASE64URL_RUNTIME_DATABASE_PASSWORD

# Enterprise OIDC registration.
COMPANY_OS_OIDC_ISSUER=https://identity.example.com
COMPANY_OS_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
COMPANY_OS_OIDC_CLIENT_ID=CHANGE_ME_OIDC_CLIENT_ID
COMPANY_OS_OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
COMPANY_OS_OIDC_REDIRECT_URI=https://company-os-api.example.com/api/auth/oauth2/callback/enterprise-oidc
COMPANY_OS_SESSION_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
COMPANY_OS_INSTANCE_ID=company-os-self-hosted
# Operator-owned contractual policy reference. This is not a deletion duration.
COMPANY_OS_RETENTION_POLICY_ID=standard-retention
COMPANY_OS_ACCOUNTABILITY_EXPORT_POLICY_ID=standard-accountability-export

# Optional installed runtime packages. Never place provider credentials here.
COMPANY_OS_CONNECTOR_PACKAGES=
COMPANY_OS_SECRET_BROKER_PACKAGE=
COMPANY_OS_MODEL_PROVIDER_PACKAGES=
COMPANY_OS_DATA_CONNECTOR_PACKAGES=
# Maintained Agent Node Connector (enable by setting the package above).
COMPANY_OS_HTTP_AGENT_NODE_ID=http-agent-node
COMPANY_OS_HTTP_AGENT_NODE_NAME=Enterprise HTTP Agent Node
COMPANY_OS_HTTP_AGENT_NODE_BASE_URL=
COMPANY_OS_HTTP_AGENT_NODE_BEARER_TOKEN=CHANGE_ME_AGENT_NODE_TRANSPORT_TOKEN
COMPANY_OS_HTTP_AGENT_NODE_ALLOW_INSECURE_LOOPBACK=false
COMPANY_OS_HTTP_AGENT_NODE_TIMEOUT_MS=10000
# Maintained Secret Broker (enable by setting the package above).
COMPANY_OS_HTTP_SECRET_BROKER_ID=http-secret-broker
COMPANY_OS_HTTP_SECRET_BROKER_NAME=Enterprise HTTP Secret Broker
COMPANY_OS_HTTP_SECRET_BROKER_BASE_URL=
COMPANY_OS_HTTP_SECRET_BROKER_BEARER_TOKEN=CHANGE_ME_SECRET_BROKER_TRANSPORT_TOKEN
COMPANY_OS_HTTP_SECRET_BROKER_ALLOW_INSECURE_LOOPBACK=false
COMPANY_OS_HTTP_SECRET_BROKER_TIMEOUT_MS=10000
COMPANY_OS_HTTP_SECRET_BROKER_MAXIMUM_LEASE_SECONDS=600
# HTTP Data Node package configuration (only when that installed package is selected).
COMPANY_OS_HTTP_DATA_NODE_ID=http-data-node
COMPANY_OS_HTTP_DATA_NODE_NAME=Enterprise HTTP Data Node
COMPANY_OS_HTTP_DATA_NODE_SOURCES=
COMPANY_OS_HTTP_DATA_NODE_OPERATIONS=READ
COMPANY_OS_HTTP_DATA_NODE_BASE_URL=
COMPANY_OS_HTTP_DATA_NODE_BEARER_TOKEN=CHANGE_ME_DATA_NODE_TRANSPORT_TOKEN
COMPANY_OS_HTTP_DATA_NODE_ALLOW_INSECURE_LOOPBACK=false
COMPANY_OS_HTTP_DATA_NODE_TIMEOUT_MS=10000
COMPANY_OS_TRUSTED_PROXY_CIDRS=
COMPANY_OS_METRICS_ENABLED=false

# Optional encrypted backup profile. Generate 32 random bytes and base64 encode
# them; inject the real value from a secret manager, never this file.
COMPANY_OS_BACKUP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
COMPANY_OS_BACKUP_INTERVAL_SECONDS=86400
# Optional S3-compatible off-site destination. Leave endpoint, region and
# bucket empty to retain encrypted backups locally only. Credentials are read
# from private files in COMPANY_OS_BACKUP_SECRET_DIRECTORY.
COMPANY_OS_BACKUP_SECRET_DIRECTORY=/etc/company-os/backup-secrets
COMPANY_OS_BACKUP_S3_ENDPOINT=https://object-storage.example.com
COMPANY_OS_BACKUP_S3_REGION=us-east-1
COMPANY_OS_BACKUP_S3_BUCKET=CHANGE_ME_DEDICATED_PRIVATE_BUCKET
COMPANY_OS_BACKUP_S3_PREFIX=backups
