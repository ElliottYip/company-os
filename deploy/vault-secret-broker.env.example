COMPANY_OS_VAULT_ADDRESS=https://vault.staging.example.com
COMPANY_OS_VAULT_AUTH_MOUNT=approle
COMPANY_OS_VAULT_NAMESPACE=company-os-staging
COMPANY_OS_VAULT_ROLE_ID_FILE=/run/secrets/vault-role-id
COMPANY_OS_VAULT_SECRET_ID_FILE=/run/secrets/vault-secret-id
COMPANY_OS_VAULT_BROKER_CONTROL_BEARER_TOKEN_FILE=/run/secrets/control-bearer-token
COMPANY_OS_VAULT_BROKER_EXECUTION_BEARER_TOKEN_FILE=/run/secrets/execution-bearer-token
COMPANY_OS_VAULT_BROKER_REFERENCES_FILE=/run/config/secret-references.json
COMPANY_OS_VAULT_BROKER_STATE_FILE=/var/lib/company-os-vault-broker/state.json
COMPANY_OS_VAULT_BROKER_REFERENCE_STATE_FILE=/var/lib/company-os-vault-broker/references.json
COMPANY_OS_VAULT_BROKER_PUBLIC_URL=https://vault-broker.staging.example.com
COMPANY_OS_VAULT_BROKER_MANAGEMENT_SIGNING_KEY_FILE=/run/secrets/management-signing-key
COMPANY_OS_VAULT_BROKER_HOST=0.0.0.0
COMPANY_OS_VAULT_BROKER_PORT=4321
COMPANY_OS_VAULT_BROKER_MAXIMUM_LEASE_SECONDS=600
