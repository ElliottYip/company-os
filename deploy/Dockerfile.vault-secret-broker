FROM node:22.12.0-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

# Vault credentials, broker bearer tokens, and secret references are mounted
# at runtime. They must never enter the image or its build cache.
COPY --chown=node:node brokers/vault-secret-broker ./brokers/vault-secret-broker

RUN mkdir -p /var/lib/company-os-vault-broker \
    && chown -R node:node /var/lib/company-os-vault-broker

USER node
EXPOSE 4321
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4321/v1/health',{headers:{authorization:'Bearer '+require('fs').readFileSync('/run/secrets/control-bearer-token','utf8').trim()}}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "brokers/vault-secret-broker/service-entry.mjs"]
