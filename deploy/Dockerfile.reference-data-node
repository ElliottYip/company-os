FROM node:22.12.0-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

COPY --chown=node:node connectors/http-data-node-reference ./connectors/http-data-node-reference

RUN mkdir -p /var/lib/company-os-data-node \
    && chown -R node:node /var/lib/company-os-data-node

USER node
EXPOSE 4321
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const fs=require('fs');fetch('http://127.0.0.1:4321/v1/health',{headers:{authorization:'Bearer '+fs.readFileSync('/run/secrets/data-node-bearer-token','utf8').trim(),'x-company-os-data-connector-protocol':'1.0'}}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "connectors/http-data-node-reference/service-entry.mjs"]
