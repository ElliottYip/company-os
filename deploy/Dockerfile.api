FROM node:22.12.0-bookworm-slim

ENV NODE_ENV=production
ENV COMPANY_OS_HOST=0.0.0.0
WORKDIR /app

COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node brokers ./brokers
COPY --chown=node:node connectors ./connectors
RUN npm ci --omit=dev --omit=optional --ignore-scripts && npm cache clean --force

COPY --chown=node:node core ./core
COPY --chown=node:node ports ./ports
COPY --chown=node:node application ./application
COPY --chown=node:node adapters ./adapters
COPY --chown=node:node connector-sdk ./connector-sdk
COPY --chown=node:node scripts ./scripts

USER node
EXPOSE 4310
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=4 \
  CMD node -e "fetch('http://127.0.0.1:4310/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "--experimental-strip-types", "adapters/http/service-entry.ts"]
