# Public, non-secret staging coordinates.
COMPANY_OS_COMPOSE_PROJECT=CHANGE_ME_SITE_COMPOSE_PROJECT
COMPANY_OS_PRODUCT_NETWORK=CHANGE_ME_SITE_PRODUCT_NETWORK
COMPANY_OS_REFERENCE_DATA_NODE_PORT=4322
COMPANY_OS_WEB_LOOPBACK_PORT=4600
COMPANY_OS_API_LOOPBACK_PORT=4601
# Opt in only for a separately approved, fixture-only exhibition Demo profile.
COMPANY_OS_PUBLIC_DEMO_ENABLED=false
COMPANY_OS_DATA_NODE_VOLUME=CHANGE_ME_SITE_DATA_NODE_VOLUME
COMPANY_OS_BACKUP_VOLUME=CHANGE_ME_SITE_BACKUP_VOLUME
COMPANY_OS_API_IMAGE=ghcr.io/CHANGE_ME/company-os-api@sha256:CHANGE_ME_64_HEX_DIGEST
COMPANY_OS_WEB_IMAGE=ghcr.io/CHANGE_ME/company-os-web@sha256:CHANGE_ME_64_HEX_DIGEST
COMPANY_OS_OPS_IMAGE=ghcr.io/CHANGE_ME/company-os-ops@sha256:CHANGE_ME_64_HEX_DIGEST
COMPANY_OS_REFERENCE_DATA_NODE_IMAGE=ghcr.io/CHANGE_ME/company-os-reference-data-node@sha256:CHANGE_ME_64_HEX_DIGEST
COMPANY_OS_PUBLIC_URL=https://CHANGE_ME_SITE_API_ORIGIN
COMPANY_OS_WEB_ORIGINS=https://CHANGE_ME_SITE_WEB_ORIGIN
COMPANY_OS_OIDC_REDIRECT_URI=https://CHANGE_ME_SITE_API_ORIGIN/api/auth/oauth2/callback/enterprise-oidc
COMPANY_OS_INSTANCE_ID=CHANGE_ME_SITE_INSTANCE_ID
COMPANY_OS_OIDC_ISSUER=https://CHANGE_ME_STAGING_IDENTITY
COMPANY_OS_OIDC_DISCOVERY_URL=https://CHANGE_ME_STAGING_IDENTITY/.well-known/openid-configuration
COMPANY_OS_OIDC_CLIENT_ID=company-os-staging
COMPANY_OS_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
COMPANY_OS_RETENTION_POLICY_ID=standard-retention
COMPANY_OS_ACCOUNTABILITY_EXPORT_POLICY_ID=standard-accountability-export
COMPANY_OS_HTTP_AGENT_NODE_ID=CHANGE_ME_SITE_AGENT_NODE_ID
COMPANY_OS_HTTP_AGENT_NODE_NAME=CHANGE_ME_SITE_AGENT_NODE_NAME
COMPANY_OS_HTTP_AGENT_NODE_BASE_URL=https://CHANGE_ME_AGENT_NODE
COMPANY_OS_HTTP_DATA_NODE_ID=CHANGE_ME_SITE_DATA_NODE_ID
COMPANY_OS_HTTP_DATA_NODE_NAME=CHANGE_ME_SITE_DATA_NODE_NAME
COMPANY_OS_HTTP_DATA_NODE_BASE_URL=https://CHANGE_ME_DATA_NODE
COMPANY_OS_HTTP_SECRET_BROKER_ID=CHANGE_ME_SITE_SECRET_BROKER_ID
COMPANY_OS_HTTP_SECRET_BROKER_NAME=CHANGE_ME_SITE_SECRET_BROKER_NAME
COMPANY_OS_HTTP_SECRET_BROKER_BASE_URL=https://CHANGE_ME_VAULT_BROKER
COMPANY_OS_HTTP_DATA_NODE_SOURCES=acceptance-fixtures
