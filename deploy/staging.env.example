# Public, non-secret staging coordinates.
COMPANY_OS_API_IMAGE=ghcr.io/CHANGE_ME/company-os-api@sha256:CHANGE_ME_64_HEX_DIGEST
COMPANY_OS_WEB_IMAGE=ghcr.io/CHANGE_ME/company-os-web@sha256:CHANGE_ME_64_HEX_DIGEST
COMPANY_OS_OPS_IMAGE=ghcr.io/CHANGE_ME/company-os-ops@sha256:CHANGE_ME_64_HEX_DIGEST
COMPANY_OS_OIDC_ISSUER=https://CHANGE_ME_STAGING_IDENTITY
COMPANY_OS_OIDC_DISCOVERY_URL=https://CHANGE_ME_STAGING_IDENTITY/.well-known/openid-configuration
COMPANY_OS_OIDC_CLIENT_ID=company-os-staging
COMPANY_OS_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
COMPANY_OS_RETENTION_POLICY_ID=standard-retention
COMPANY_OS_ACCOUNTABILITY_EXPORT_POLICY_ID=standard-accountability-export
COMPANY_OS_HTTP_AGENT_NODE_BASE_URL=https://CHANGE_ME_AGENT_NODE
COMPANY_OS_HTTP_DATA_NODE_BASE_URL=https://CHANGE_ME_DATA_NODE
COMPANY_OS_HTTP_SECRET_BROKER_BASE_URL=https://CHANGE_ME_VAULT_BROKER
COMPANY_OS_HTTP_DATA_NODE_SOURCES=acceptance-fixtures
COMPANY_OS_HTTP_DATA_NODE_OPERATIONS=READ

# Host directory containing files named exactly as documented in
# docs/staging-raft-xin.md. Never place their values in this file.
COMPANY_OS_SECRET_DIRECTORY=/etc/company-os/secrets
