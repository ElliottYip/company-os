COMPANY_OS_BACKUP_INTERVAL_SECONDS=86400
COMPANY_OS_BACKUP_S3_ENDPOINT=https://CHANGE_ME_OBJECT_STORAGE_ENDPOINT
COMPANY_OS_BACKUP_S3_REGION=us-east-1
COMPANY_OS_BACKUP_S3_BUCKET=CHANGE_ME_DEDICATED_PRIVATE_BUCKET
COMPANY_OS_BACKUP_S3_PREFIX=backups

# Host directory containing files named exactly as documented in
# docs/staging-raft-xin.md. Never place their values in this file.
COMPANY_OS_SECRET_DIRECTORY=/etc/company-os/secrets
